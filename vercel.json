{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd aurorastream-web && npm install",
  "buildCommand": "cd aurorastream-web && npm run build",
  "outputDirectory": "aurorastream-web/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
